# remote-sense configuration contract. Copy to .env and fill in.
# All settings are read via pydantic-settings with the RS_ prefix. No secrets in code.

# --- App ---
RS_APP_ENV=dev
RS_LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS ---
RS_DATABASE_URL=postgresql+psycopg://rs:rs@postgres:5432/remote_sense

# --- Redis (cache, Celery broker, quota counters) ---
RS_REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO / S3-compatible) for index COGs ---
RS_MINIO_ENDPOINT=minio:9000
RS_MINIO_ACCESS_KEY=minioadmin
RS_MINIO_SECRET_KEY=minioadmin
RS_MINIO_BUCKET=remote-sense
RS_MINIO_SECURE=false

# --- Imagery access layer ---
# Active adapter is a config switch: mock | server_compute | windowed_cog
RS_IMAGERY_ADAPTER=mock
RS_BACKFILL_MONTHS=18

# --- CDSE (endpoint deliberately unspecified in code; provide via env) ---
RS_CDSE_TOKEN_URL=
RS_CDSE_CLIENT_ID=
RS_CDSE_CLIENT_SECRET=
RS_CDSE_STAC_URL=

# --- Gateway push (⚑ CONFIRM: URL/auth/payload provided by gateway team) ---
RS_GATEWAY_PUSH_URL=
RS_GATEWAY_AUTH_TOKEN=

# --- Arrival notification (⚑ CONFIRM) default: db_poll | webhook | listen_notify ---
RS_ARRIVAL_SOURCE=db_poll

# --- Interpretation layer (Claude API) ---
RS_ANTHROPIC_API_KEY=
RS_ANTHROPIC_MODEL=claude-opus-4-8
