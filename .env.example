# remote-sense configuration contract. Copy to .env and fill in.
# All settings are read via pydantic-settings with the RS_ prefix. No secrets in code.

# --- App ---
RS_APP_ENV=dev
RS_LOG_LEVEL=INFO

# --- Observability (OpenTelemetry) ---
# Opt-in. When disabled, or with no endpoint / packages, tracing is a safe no-op.
# Install the extra to activate: pip install -e ".[observability]"
RS_OTEL_ENABLED=false
RS_OTEL_SERVICE_NAME=remote-sense
RS_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- PostgreSQL + PostGIS ---
RS_DATABASE_URL=postgresql+psycopg://rs:rs@postgres:5432/remote_sense

# --- Redis (cache, Celery broker, quota counters) ---
RS_REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO / S3-compatible) for index COGs ---
RS_MINIO_ENDPOINT=minio:9000
RS_MINIO_ACCESS_KEY=minioadmin
RS_MINIO_SECRET_KEY=minioadmin
RS_MINIO_BUCKET=remote-sense
RS_MINIO_SECURE=false

# --- Imagery access layer ---
# Active adapter is a config switch: mock | server_compute | windowed_cog
RS_IMAGERY_ADAPTER=mock
RS_BACKFILL_MONTHS=18
# COG retention horizon in months (S4.3): index-preview COGs whose pass is older than this are
# pruned weekly (stats/provenance rows are never touched). Empty = match RS_BACKFILL_MONTHS.
RS_COG_RETENTION_MONTHS=

# --- CDSE (endpoint deliberately unspecified in code; provide via env) ---
RS_CDSE_TOKEN_URL=
RS_CDSE_CLIENT_ID=
RS_CDSE_CLIENT_SECRET=
RS_CDSE_STAC_URL=
# windowed_cog adapter (ADR 0002): the STAC collection to search, and the eodata S3 store the
# product rasters live in (reached over GDAL /vsis3/). The S3 keys are issued from the CDSE
# dashboard and are distinct from the OAuth2 client credentials above.
RS_CDSE_STAC_COLLECTION=sentinel-2-l2a
RS_CDSE_S3_ENDPOINT=
RS_CDSE_S3_ACCESS_KEY=
RS_CDSE_S3_SECRET_KEY=
RS_CDSE_S3_REGION=default
# server_compute adapter (ADR 0003): the CDSE Process API endpoint for server-side index previews.
RS_CDSE_PROCESS_URL=

# --- Weather access layer (Tier 1, ADR 0004) ---
# Active adapter is a config switch: mock | open_meteo
RS_WEATHER_ADAPTER=mock
RS_WEATHER_API_URL=

# --- AgriTrack activity logs (Tier 2, ADR 0005). Read-only, joined on canonical farm/field id ---
# Active adapter is a config switch: mock | gateway
RS_ACTIVITY_ADAPTER=mock
RS_ACTIVITY_API_URL=

# --- Gateway push (ADR 0006: AgriTrack contract). Adapter switch: recording | http | agritrack ---
# `recording` is a dry-run sink: it records "published" without sending anything (the workspace shows
# "Recorded (dry-run)", not "Sent"). To actually deliver to AgriTrack, set RS_GATEWAY_ADAPTER=agritrack
# and fill RS_AGRITRACK_BASE_URL (an absolute http(s):// URL) + RS_AGRITRACK_API_KEY. The publish
# endpoint fails fast with 503 if a real-push adapter is selected but its URL/key is missing,
# placeholder, or scheme-less, so a misconfigured push never silently no-ops. A push that reaches an
# unreachable host or an offline tunnel dead-letters with the reason (retry from the workspace once
# it is back up); the push is idempotent so a retry is safe.
RS_GATEWAY_ADAPTER=recording
RS_GATEWAY_PUSH_URL=
RS_GATEWAY_AUTH_TOKEN=
# Max simultaneous record POSTs in one farm push (one POST per record to /integrations/satellite/results).
RS_GATEWAY_MAX_CONCURRENCY=10
# AgriTrack integration (ADR 0006). One key both ways: we send it as X-Api-Key; inbound /mobile/* requires it.
RS_AGRITRACK_BASE_URL=
RS_AGRITRACK_API_KEY=

# --- Arrival notification (confirmed: db_poll; webhook | listen_notify can swap in later) ---
RS_ARRIVAL_SOURCE=db_poll

# --- Interpretation layer (Claude API) ---
RS_ANTHROPIC_API_KEY=
RS_ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth / RBAC (Phase 7). The IdP/gateway issues JWTs; the API only verifies them (HS256). ---
# Any environment that serves the workspace BFF MUST set RS_JWT_SECRET: an empty secret makes every
# RBAC-gated endpoint fail with 500 "auth is not configured". For local dev, generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
# and mint a token signed with it. Never commit a real secret. RS_JWT_AUDIENCE is optional (enforced
# only when set).
RS_JWT_SECRET=
RS_JWT_ALGORITHM=HS256
RS_JWT_AUDIENCE=

# --- API CORS. The browser workspace (L6) calls the API cross-origin, so list its origin(s). ---
# Comma-separated; empty disables CORS. Dev default is the Vite server; set the deployed workspace
# origin(s) in production.
RS_CORS_ALLOW_ORIGINS=http://localhost:5173
