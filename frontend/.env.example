# Workspace BFF (services/api). RBAC-gated read endpoints: /farms, /fields, ...
VITE_API_BASE_URL=http://localhost:8000

# Tiler (services/tiler). nginx fronts it on 8000 (tiles serve at /tiles/), so this matches the
# API origin in the docker compose stack. Point it elsewhere only if the tiler is exposed directly.
VITE_TILER_BASE_URL=http://localhost:8000

# MapLibre base style. Three modes:
#   blank (default) -> built-in key-free Carto street/terrain raster basemap
#   none            -> blank offline style, no external tile calls (air-gapped use)
#   <style URL>     -> your own MapLibre style (vector or raster) overrides the default
VITE_BASEMAP_URL=

# Optional dev convenience: a bearer token seeded into the session so you skip the token gate.
# Never commit a real token. The production flow gets this from the gateway IdP.
VITE_DEV_TOKEN=
